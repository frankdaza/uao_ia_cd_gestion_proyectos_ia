# Bytecode y artefactos de compilación de Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
.eggs/
dist/
build/

# Entornos virtuales (UV suele usar .venv en el proyecto)
.venv/
venv/
env/

# Herramientas de prueba, cobertura y calidad
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/

# Jupyter
.ipynb_checkpoints/

# Sistema operativo y editores
.DS_Store
Thumbs.db
.idea/

# Variables de entorno y secretos locales (no subir credenciales)
.env
.env.*
!.env.example

# ---------------------------------------------------------------------------
# Datos y modelos (TDSP): no versionar artefactos grandes; conservar carpetas con .gitkeep
# ---------------------------------------------------------------------------
data/raw/*
!data/raw/.gitkeep
!data/raw/README.md
data/processed/*
!data/processed/.gitkeep
!data/processed/README.md
outputs/models/*
!outputs/models/.gitkeep
